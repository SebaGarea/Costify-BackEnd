# ============================================================
#  Costify — Variables de la DEMO pública (api-demo)
# ============================================================
#  cp env.demo.example .env.demo   (en la carpeta deploy/ de la VM)
#  Lo demás (DEMO_MODE, base mongo-demo, claves vacías) está fijado en
#  docker-compose.prod.yml y no se puede pisar desde acá.
# ============================================================

# Secreto propio de la demo (distinto al de producción):
#   openssl rand -hex 48
JWT_SECRET=

# Frontend de la demo autorizado (coma-separados)
CORS_ORIGINS=https://tu-demo.vercel.app
